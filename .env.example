# ===== 校园网关认证（必填）=====
ZJU_USERNAME=3240100000
ZJU_PASSWORD=your_passw0rd

# ===== 钉钉通知 =====
# 等于字符串 "true" 才启用推送
ENABLE_DINGTALK=true
DINGTALK_WEBHOOK="https://oapi.dingtalk.com/robot/send?access_token=your_access_token"
# 加签模式机器人的 SEC 开头密钥；关键词 / IP 白名单模式可留空
DINGTALK_SECRET="SECyour_secret_token"

# ===== 课堂关键词预警 =====
# 逗号分隔；留空用默认: 签到,扫码,二维码,小测,测验,点名
KEYWORDS=签到,扫码,二维码,小测,测验,点名
# 同一关键词两次告警的最小间隔秒数（防半句重复帧轰炸，也天然满足钉钉 20条/分钟频控）
KEYWORD_COOLDOWN_SECONDS=120
# 只在句子定稿后才匹配告警；默认 false=半句命中立刻报（延迟优先，可能有同音误报，如"请到"→"签到"）
ALERT_ON_FINAL_ONLY=false
# 钉钉消息标题。若机器人开了"自定义关键词"安全设置，请把它改成那个关键词
ALERT_TITLE=【课堂预警】

# ===== 监听方式 =====
# auto=有实时字幕通道走 WebSocket、多次重连失败降级轮询；ws=强制 WebSocket；poll=强制轮询
LISTEN_MODE=auto
# 轮询模式间隔秒数（轮询延迟取决于服务端缓存，未经验证，仅供降级/重放用）
POLL_INTERVAL_SECONDS=15
# WebSocket 连续静默多少秒视为僵死（触发重连或课程结束检测）
WS_STALE_TIMEOUT_SECONDS=300
# WebSocket 重连退避上限秒数
WS_RECONNECT_MAX_SECONDS=60

# ===== 其他 =====
REQUEST_TIMEOUT_MS=20000
# true=打印无法解析的 WS 原始帧等调试信息（排障用）
DEBUG_RAW=false

# ===== Web 控制台（node server.js）=====
# 监听端口（固定绑定 127.0.0.1，修改后需重启生效）
WEB_PORT=5175
# true=开放 /api/dev/fragment 人工注入接口（验证界面 interim/告警用，平时关闭）
WEB_DEV_TOOLS=false

# ===== 自动签到（学在浙大）=====
# 雷达点名的首选信号点，可选值见 checkin.js 的 RADAR_SITES（默认 YQ1=玉泉教一）
#CHECKIN_RADAR_AT=YQ1
